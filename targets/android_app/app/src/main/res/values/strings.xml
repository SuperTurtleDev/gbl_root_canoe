    <!-- Post-OTA retention -->
    <string name="ota_title">Post-OTA operation</string>
    <string name="ota_body">Run after an OTA has been installed and BEFORE rebooting. This patches the OTA-written ABL into a new boot.efi (the previous one becomes boot_backup.efi and is appended to the boot order), re-flashes the BDS, and copies the current old-BL ABL over the target slot so the next boot keeps the old bootloader. Refuses to run twice.</string>
    <string name="ota_run">Run post-OTA flash</string>
    <string name="ota_busy">Running post-OTA flash…</string>
    <string name="ota_btn">Post-OTA</string>

