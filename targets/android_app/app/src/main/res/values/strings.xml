    <string name="settings">Settings</string>
    <string name="sb_state_title">Secure boot (BOOT_CERTS)</string>
    <string name="sb_state_disabled">Disabled</string>
    <string name="sb_state_enabled">Enabled - all EFI images signed</string>
    <string name="sb_state_degraded">Not properly enabled - unsigned EFI images present</string>
    <string name="sb_degraded_hint">Some EFI files are not signed; the BDS will refuse to launch them. Re-sign to fix.</string>
    <string name="sb_key_hint">The key is an RSA-2048 identity inside the device keystore (StrongBox when available), bound to your fingerprint. Every signature needs a biometric prompt; the private key never leaves the hardware.</string>
    <string name="sb_enable_title">Enable secure boot</string>
    <string name="sb_enable_body">Generates the hardware key, signs EVERY EFI under persist/efisp (one fingerprint prompt per file) and writes the certificate into BOOT_CERTS. All files must succeed - otherwise nothing is enabled. The BDS enforces verification from the next boot.</string>
    <string name="sb_enable_run">Enable secure boot</string>
    <string name="sb_resign">Re-sign all EFI files</string>
    <string name="sb_disable_title">Disable secure boot</string>
    <string name="sb_disable_body">Remove the BOOT_CERTS certificate and the keystore key? Signed EFI files stay as they are but are no longer verified.</string>
